<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>view_controller_msgs</name>
  <version>3.0.0</version>
  <description>
    Stopgap ROS 2 port of view_controller_msgs used by jsk_rviz_plugins.
    Message definitions are identical to the ROS 1 package
    (https://github.com/ros-visualization/view_controller_msgs). Remove
    this package once an official ROS 2 release exists.
  </description>
  <maintainer email="k-okada@jsk.t.u-tokyo.ac.jp">Kei Okada</maintainer>
  <license>BSD</license>

  <url type="repository">https://github.com/ros-visualization/view_controller_msgs</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
