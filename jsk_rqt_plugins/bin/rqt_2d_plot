#!/usr/bin/env python3

import sys

import rclpy
from rqt_gui.main import Main

from jsk_rqt_plugins.plot_2d import Plot2D


def main():
    # Initialize rclpy with the full command line so that ROS arguments
    # (parameters / remappings passed by ros2 launch) reach the node
    # created by rqt_gui.
    rclpy.init(args=sys.argv)
    plugin = 'jsk_rqt_plugins.plot_2d.Plot2D'
    main = Main(filename=plugin)
    sys.exit(main.main(
        standalone=plugin, plugin_argument_provider=Plot2D.add_arguments))


if __name__ == '__main__':
    main()
