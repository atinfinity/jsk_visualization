#!/usr/bin/env python3

import sys

import rclpy
from rqt_gui.main import Main


def main():
    # Initialize rclpy with the full command line so that ROS arguments
    # (e.g. the tabbed_layout_yaml_file parameter passed by ros2 launch)
    # reach the node created by rqt_gui.
    rclpy.init(args=sys.argv)
    plugin = 'jsk_rqt_plugins.tabbed_button.ServiceTabbedButtons'
    main = Main(filename=plugin)
    sys.exit(main.main(standalone=plugin))


if __name__ == '__main__':
    main()
